# Copy to backend/.env and fill in. Never commit the real .env.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for new chats; must be one of the ids in app/model_registry.py
CLAUDE_MODEL=claude-sonnet-4-5

# Supabase > Project Settings > API Keys (use a *secret* key, not the publishable one)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Shared password for the web app, at least 12 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
APP_PASSWORD=

# Optional
# MAX_CONTEXT_TOKENS=100000            # cost cap on input tokens per request
# FRONTEND_ORIGINS=http://localhost:3000  # comma-separated, for CORS
